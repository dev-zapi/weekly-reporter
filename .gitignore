# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# Go binary produced by `make build`
/bin/

# misc
.DS_Store
*.pem
.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/lib/build-info.ts
# SPA build-info (generated by web/scripts/gen-build-info.mjs, ADR-0028)
web/src/build-info.ts

# Database
data/
*.db

# CodeGraph local index/runtime files
.codegraph/

# XDG data directories (for development)
.local/

# playwright
.playwright-cli/
.playwright-mcp/
test-results/
playwright-report/
blob-report/
*.yml
*.yaml
# sqlc config is source, not a playwright artifact
!sqlc.yaml

# skill eval workspaces (transient artifacts from skill-creator runs)
skills/*-workspace/
.e2e-worker-*/

# pnpm workspace: source config + shared lockfile must be tracked so a fresh
# clone can `pnpm install` reproducibly (the generic *.yaml rule above would
# otherwise silently ignore them).
!pnpm-workspace.yaml
!pnpm-lock.yaml

# SPA workspace (web/): install tree and build output. web/dist is a build
# artifact (`vite build`, gitignored like .next/), but the directory must exist
# for `//go:embed all:dist` on a fresh clone — .gitkeep keeps it.
/web/node_modules
/web/dist/*
!/web/dist/.gitkeep
/web/src/build-info.ts
